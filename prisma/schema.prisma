// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  name         String?
  studentId    String?
  department   String?
  course       String?
  avatarUrl    String?
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  feedback     Feedback[]
}

enum Role {
  STUDENT
  ADMIN
  GUEST
}

model Building {
  id          String   @id @default(uuid())
  name        String
  description String?
  latitude    Float
  longitude   Float
  geometry    Json?    // Array of polygon coordinates
  imageUrl    String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  floors      Floor[]
  rooms       Room[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  icon      String?    // Lucide icon name
  buildings Building[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Floor {
  id          String   @id @default(uuid())
  level       Int
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  mapImageUrl String?
  rooms       Room[]
  nodes       MapNode[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Room {
  id          String   @id @default(uuid())
  name        String
  type        String?  // Classrooms, Lab, Office, etc.
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floorId     String
  floor       Floor    @relation(fields: [floorId], references: [id])
  latitude    Float?
  longitude   Float?
  nodeId      String?  @unique
  node        MapNode? @relation(fields: [nodeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MapNode {
  id        String   @id @default(uuid())
  latitude  Float
  longitude Float
  floorId   String?
  floor     Floor?   @relation(fields: [floorId], references: [id])
  type      NodeType @default(INTERSECTION)
  
  // Relations
  outgoingEdges MapEdge[] @relation("EdgeStart")
  incomingEdges MapEdge[] @relation("EdgeEnd")
  room          Room?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum NodeType {
  INTERSECTION
  ENTRANCE
  POI
  STAIRS
  ELEVATOR
}

model MapEdge {
  id           String   @id @default(uuid())
  startNodeId  String
  startNode    MapNode  @relation("EdgeStart", fields: [startNodeId], references: [id])
  endNodeId    String
  endNode      MapNode  @relation("EdgeEnd", fields: [endNodeId], references: [id])
  distance     Float    // Pre-calculated weight (meters)
  type         EdgeType @default(WALKWAY)
  isAccessible Boolean  @default(true)
  geometry     Json?    // Array of coordinates for the polyline
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EdgeType {
  WALKWAY
  STAIRS
  ELEVATOR
  INDOOR
}

model NavigationPath {
  id          String   @id @default(uuid())
  fromName    String
  toName      String
  pathData    Json     // Array of coordinates or steps
  distance    Float
  estimatedTime Int    // In seconds
  createdAt   DateTime @default(now())
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  content   String
  rating    Int
  createdAt DateTime @default(now())
}

model Analytics {
  id          String   @id @default(uuid())
  eventType   String   // location_usage, search, nav_start, nav_end
  eventData   Json
  timestamp   DateTime @default(now())
}
